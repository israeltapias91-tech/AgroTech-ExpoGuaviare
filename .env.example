# Variables de entorno de ejemplo — ExpoGuaviare AgroTech.
# Copiar este archivo como .env y ajustar localmente.
# Nunca subir valores reales ni contraseñas a ningún repositorio.

# IP del broker Mosquitto en la red local (ejemplo sin IP real de este equipo).
# El TXT, el gateway y la app deben usar la IP actual del PC que hospeda Mosquitto.
BROKER_HOST=192.168.1.100
BROKER_PORT=1884
BROKER_TXT_PORT=1884

# Usuario dedicado del broker dedicado (la contraseña va solo en config.ini privado).
MQTT_USER_TXT=agrotech_txt

# Ruta de instalación de Mosquitto en Windows (ajustar si difiere en tu PC).
MOSQUITTO_DIR=C:\Program Files\mosquitto

# Puerto del broker local de prueba (solo localhost, fase de desarrollo).
MQTT_LOCAL_PORT=1883
